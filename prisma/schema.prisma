generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  email      String
  adDn       String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  attempts   Int       @default(0)
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
}
