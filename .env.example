# Copier ce fichier en .env.local et remplir toutes les valeurs avant déploiement
# cp .env.example .env.local

# --- Base de données SQLite ---
# Utiliser un chemin absolu en production (requis pour PM2)
DATABASE_URL=file:/CHEMIN_ABSOLU_VERS_LE_PROJET/sspr-app/prisma/dev.db

# --- Active Directory (LDAPS) ---
# Format : ldaps://NOM_DU_DC.DOMAINE.local:636
AD_URL=ldaps://NOM_DU_DC.DOMAINE.local:636
AD_BASE_DN=DC=DOMAINE,DC=local
# DN complet du compte de service (doit avoir la délégation "Réinitialiser le mot de passe")
AD_BIND_DN=CN=NOM_COMPTE_SERVICE,OU=...,DC=DOMAINE,DC=local
AD_BIND_PASSWORD=MOT_DE_PASSE_DU_COMPTE_SERVICE

# Mettre à true en production (avec AD_TLS_CA_CERT_PATH si CA interne)
# Mettre à false uniquement en développement si le certificat n'est pas importé
AD_TLS_REJECT_UNAUTHORIZED=true
# Optionnel : chemin vers le certificat CA de l'AD en PEM (si CA interne non reconnue)
# AD_TLS_CA_CERT_PATH=/chemin/vers/ca.pem

# --- SMTP (envoi des OTP par email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ADRESSE_GMAIL@gmail.com
# Mot de passe d'application Gmail (pas le mot de passe du compte)
# Générer sur : https://myaccount.google.com/apppasswords
SMTP_PASS=XXXX_XXXX_XXXX_XXXX
SMTP_FROM=ADRESSE_GMAIL@gmail.com

# --- Sécurité OTP ---
# Générer avec : openssl rand -base64 32
OTP_SECRET=GENERER_AVEC_openssl_rand_-base64_32

# --- URLs de l'application ---
APP_BASE_URL=https://NOM_DNS_OU_IP:PORT
NEXTAUTH_URL=https://NOM_DNS_OU_IP:PORT
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=GENERER_AVEC_openssl_rand_-base64_32

# --- Nom affiché dans les emails et l'interface ---
APP_NAME=NOM_DE_VOTRE_ORGANISATION
