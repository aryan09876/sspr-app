# ═══════════════════════════════════════════════════════════════════════════════
#  SSPR — Variables d'environnement
#
#  INSTRUCTIONS :
#    1. Copiez ce fichier :  cp .env.example .env.local
#    2. Remplissez toutes les valeurs ci-dessous
#    3. Lancez : npx prisma migrate deploy && npm run build && npm start
#
#  NOTE : Si vous utilisez setup/install.sh, ce fichier est généré automatiquement
#         à partir de setup/config.sh — vous n'avez PAS besoin de le créer manuellement.
# ═══════════════════════════════════════════════════════════════════════════════

# --- Base de données SQLite ---
# Chemin ABSOLU obligatoire (sinon PM2 ne trouve pas le fichier)
# Exemple : file:/home/admin/sspr-app/prisma/dev.db
DATABASE_URL=file:/CHEMIN_ABSOLU/sspr-app/prisma/dev.db

# --- Active Directory (LDAPS) ---
# URL du contrôleur de domaine — DOIT être en ldaps:// (port 636)
AD_URL=ldaps://NOM_DU_DC.DOMAINE.local:636
# Base de recherche LDAP — racine de votre domaine
AD_BASE_DN=DC=DOMAINE,DC=local
# DN complet du compte de service (doit avoir la délégation "Réinitialiser le mot de passe")
# Exemple : CN=SVC-PwdReset,OU=Comptes de service,DC=mondomaine,DC=local
AD_BIND_DN=CN=NOM_COMPTE_SERVICE,OU=...,DC=DOMAINE,DC=local
# Mot de passe du compte de service AD
AD_BIND_PASSWORD=MOT_DE_PASSE_DU_COMPTE_SERVICE

# Validation du certificat TLS du contrôleur de domaine
# true  = vérifie le certificat (recommandé en production — nécessite AD_TLS_CA_CERT_PATH)
# false = ignore les erreurs de certificat (acceptable en développement uniquement)
AD_TLS_REJECT_UNAUTHORIZED=true
# Chemin vers le certificat CA de votre AD (format PEM / .crt)
# Téléchargeable depuis http://VOTRE-DC/certsrv → "Télécharger un certificat d'autorité de certification"
# AD_TLS_CA_CERT_PATH=/chemin/vers/CA-votre-domaine.crt

# --- SMTP (envoi des codes OTP par email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Adresse Gmail dédiée à l'envoi des codes
SMTP_USER=ADRESSE_GMAIL@gmail.com
# Mot de passe d'APPLICATION Gmail (16 caractères, format : xxxx xxxx xxxx xxxx)
# Générer sur : https://myaccount.google.com/apppasswords
# ⚠ Ce n'est PAS le mot de passe du compte Gmail
SMTP_PASS=XXXX_XXXX_XXXX_XXXX
SMTP_FROM=ADRESSE_GMAIL@gmail.com

# --- Sécurité OTP ---
# Clé secrète pour le hachage HMAC-SHA256 des codes OTP
# Générer avec : openssl rand -base64 32
# ⚠ Ne JAMAIS changer après déploiement (invaliderait tous les codes en cours)
OTP_SECRET=GENERER_AVEC_openssl_rand_-base64_32

# --- URL de l'application ---
# URL publique par laquelle les utilisateurs accèdent à l'app
# Exemple : https://mdp.mondomaine.local  ou  http://192.168.1.10:3000
APP_BASE_URL=https://NOM_DNS_OU_IP

# --- Nom affiché ---
# Apparaît dans l'interface web et dans les emails envoyés aux utilisateurs
APP_NAME=NOM_DE_VOTRE_ORGANISATION
